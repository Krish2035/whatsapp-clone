# =============================================================================
# WHATSAPP CLONE BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (Primary / Write Database)
# Example Neon Tech URI: postgresql://username:password@ep-example-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/whatsapp_clone

# Local PostgreSQL Fallback (Used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_clone

# PostgreSQL Read Replica Configuration (High-Scale Read Query Splitting)
# If left empty, read queries automatically query the Primary database
DATABASE_READ_URL=
DB_READ_HOST=localhost
DB_READ_PORT=5433
DB_READ_USER=postgres
DB_READ_PASSWORD=postgres
DB_READ_NAME=whatsapp_clone

# Redis Cache & Rate-Limiting Configuration (Optional: in-memory fallback if not available)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting Bypass Key (for automated integration test suites)
RATE_LIMIT_BYPASS_KEY=your_optional_test_bypass_key

# JWT Authentication Secret
JWT_SECRET=super_secure_production_jwt_secret_key_change_me_12345

# Allowed CORS Origins
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Optional Call Timeout (seconds)
CALL_RING_TIMEOUT=30
