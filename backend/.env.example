# =============================================================================
# WHATSAPP CLONE BACKEND ENVIRONMENT CONFIGURATION (RENDER DEPLOYMENT)
# =============================================================================

# Server Port (Render sets process.env.PORT automatically)
PORT=5000
NODE_ENV=production

# Database Configuration (Neon PostgreSQL Cloud Connection String)
# Example Neon Tech URI: postgresql://username:password@ep-example-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_neon_user:your_neon_password@your_neon_host.neon.tech/neondb?sslmode=require

# Local PostgreSQL Fallback (Used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_clone

# JWT Authentication Secret (Generate a strong random secret key!)
JWT_SECRET=super_secure_production_jwt_secret_key_change_me_12345

# Allowed CORS Origins (Vercel Frontend URL & Custom Domains)
CLIENT_URL=https://whatsapp-clone-nu-lyart.vercel.app,https://whatsapp-clone-26utiwfat-krish2035s-projects.vercel.app,http://localhost:3000

# Optional Call Timeout (seconds)
CALL_RING_TIMEOUT=30
