# =============================================================================
# WHATSAPP CLONE FRONTEND ENVIRONMENT CONFIGURATION (VERCEL DEPLOYMENT)
# =============================================================================

# Render Backend URL (HTTPS API and WebSocket Gateway)
NEXT_PUBLIC_API_URL=https://whatsapp-backend-ea92.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://whatsapp-backend-ea92.onrender.com

# Legacy Vite Environment Variables (Supported as fallback)
VITE_API_URL=https://whatsapp-backend-ea92.onrender.com
VITE_SOCKET_URL=https://whatsapp-backend-ea92.onrender.com

# Agora App ID (Voice and Video Calls)
NEXT_PUBLIC_AGORA_APP_ID=4876b5d9bc3741ec9cb33b3dcfdbca91
VITE_AGORA_APP_ID=4876b5d9bc3741ec9cb33b3dcfdbca91

# STUN / TURN WebRTC Configurations (Optional - defaults applied automatically)
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_SERVER=turn:openrelay.metered.ca:80
NEXT_PUBLIC_TURN_USERNAME=openrelayproject
NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject
