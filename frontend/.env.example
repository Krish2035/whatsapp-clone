# Frontend Environment Variables (Exposed to browser via Vite)
VITE_API_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# WebRTC STUN/TURN Configuration (Optional - standard STUN/TURN defaults applied automatically)
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=turn:your-turn-server.com:3478
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential
